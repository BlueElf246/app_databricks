# Copy this file to .env and fill in real values:  cp .env.example .env

# ---- YouTube Data API v3 ----
YOUTUBE_API_KEY=

# ---- Lakebase / Postgres connection ----
PGHOST=localhost
PGDATABASE=youtube_app
PGUSER=postgres
PGPASSWORD=
PGPORT=5432
APP_SCHEMA=public

# sslmode: "require" for Lakebase, "prefer" for local Postgres
PGSSLMODE=prefer

# ---- Transcript proxy (Webshare) — optional ----
PROXY_USER=
PROXY_PASS=
